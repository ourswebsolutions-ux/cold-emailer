generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================================================
// USER
// ==================================================

model User {
  id                String         @id @default(cuid())
  phone             String         @unique
  passwordHash      String
  name              String?
  role              UserRole       @default(USER)
  status            UserStatus     @default(DISABLED)
  passwordExpiresAt DateTime
  sessionExpiresAt  DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  smtpConfigs       SMTPConfig[]
  emails            Email[]
  systemConfig      SystemConfig[]
  emailTemplates    EmailTemplate[]
  followUpCampaigns FollowUpCampaign[]
  inboxThreads      InboxThread[]
  inboxFollowUps    InboxFollowUp[]
}

// ==================================================
// SMTP CONFIG
// ==================================================

model SMTPConfig {
  id                 String         @id @default(cuid())
  userId             String
  host               String?
  port               Int?
  spixwork           Json?
  username           String?
  password           String?
  senderEmail        String
  senderName         String?
  provider           EmailProvider  @default(SMTP)
  accessToken        String?        @db.Text
  refreshToken       String?        @db.Text
  tokenExpiry        DateTime?
  imapHost           String?
  imapPort           Int?
  imapSecure         Boolean        @default(true)
  isActive           Boolean        @default(false)
  warmup             Boolean        @default(false)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailHealth        EmailHealth?
  inboxThreads       InboxThread[]
  inboxMessages      InboxMessage[]
  inboxFollowUps     InboxFollowUp[]
  
  followUpCampaigns FollowUpCampaign[]
  inboxSyncState     InboxSyncState?

  @@unique([userId, senderEmail])
}

// ==================================================
// SYSTEM CONFIG
// ==================================================

model SystemConfig {
  id          String   @id @default(cuid())
  userId      String
  host        String?
  port        Int?
  username    String?
  password    String?
  senderEmail String
  senderName  String?
  isActive    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, senderEmail])
}

// ==================================================
// EMAIL TEMPLATE
// ==================================================

model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String

  subject   String
  body      String?  @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  followUpSteps FollowUpStep[]

  @@index([userId])
}
// ==================================================
// EMAIL / CONTACT
// ==================================================

model Email {
  id          String   @id @default(cuid())
  userId      String

  name        String?
  email       String
  company     String?
  website     String?
  phone       String?
  category    String?

  status      EmailStatus @default(PENDING)

  isVerified  Boolean  @default(false)
  isValid     Boolean?

  notes       String?  @db.Text
  customFields Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpRecipients   FollowUpRecipient[]

  @@index([userId])
  @@index([email])
  @@index([category])
}

// ==================================================
// EMAIL HEALTH
// ==================================================

model EmailHealth {
  id             String      @id @default(cuid())
  smtpConfigId   String      @unique

  warmupDay      Int         @default(1)
  dailyLimit     Int         @default(3)

  totalSent      Int         @default(0)
  totalReplies   Int         @default(0)

  todaySent      Int         @default(0)
  todayReplies   Int         @default(0)

  nextWarmupAt   DateTime?
  health         Int         @default(0)

  startedAt      DateTime    @default(now())
  lastWarmupDate DateTime?
  completed      Boolean     @default(false)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  smtpConfig     SMTPConfig  @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)
}

// ==================================================
// SPIN GREETING
// ==================================================

model SpinGreeting {
  id        String   @id @default(cuid())
  userId    String
  value     String
  spixwork  Boolean? @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, value])
  @@index([userId])
}

// ==================================================
// INBOX THREAD
// ==================================================

model InboxThread {
  id               String    @id @default(cuid())
  userId           String
  smtpConfigId     String
  providerThreadId String?
  subject          String?   @db.Text
  participants     Json?
  lastMessageAt    DateTime?
  unreadCount      Int       @default(0)
  isStarred        Boolean   @default(false)
  isArchived       Boolean   @default(false)
  isDeleted        Boolean   @default(false)
  snippet          String?   @db.Text

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  smtpConfig       SMTPConfig @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)

  messages         InboxMessage[]
  followUps        InboxFollowUp[]

  @@unique([smtpConfigId, providerThreadId])
  @@index([userId, smtpConfigId])
  @@index([userId, lastMessageAt])
  @@index([smtpConfigId, isArchived, isDeleted])
}

// ==================================================
// INBOX MESSAGE
// ==================================================

model InboxMessage {
  id                String           @id @default(cuid())
  threadId          String
  smtpConfigId      String

  providerMessageId String
  inReplyTo         String?
  references        String?          @db.Text

  fromEmail         String
  fromName          String?

  toEmails          Json
  ccEmails          Json?
  bccEmails         Json?

  subject           String?          @db.Text
  textBody          String?          @db.LongText
  htmlBody          String?          @db.LongText
  snippet           String?          @db.Text

  receivedAt        DateTime?
  sentAt            DateTime?

  isRead            Boolean          @default(false)
  isStarred         Boolean          @default(false)

  direction         MessageDirection @default(INCOMING)
  hasAttachments    Boolean          @default(false)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  thread            InboxThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  smtpConfig        SMTPConfig       @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)

  attachments       InboxAttachment[]
  followUps         InboxFollowUp[]

  @@unique([smtpConfigId, providerMessageId])
  @@index([threadId, receivedAt])
  @@index([smtpConfigId, isRead])
}

// ==================================================
// INBOX ATTACHMENT
// ==================================================

model InboxAttachment {
  id                   String        @id @default(cuid())
  messageId            String

  filename             String
  contentType          String?
  size                 Int?
  storagePath          String?
  contentId            String?
  providerAttachmentId String?

  createdAt            DateTime      @default(now())

  message              InboxMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ==================================================
// INBOX FOLLOW UP
// ==================================================

model InboxFollowUp {
  id           String         @id @default(cuid())
  userId       String
  smtpConfigId String

  threadId     String?
  messageId    String?

  toEmail      String
  ccEmails     Json?

  subject      String
  body         String         @db.LongText

  scheduledAt  DateTime
  sentAt       DateTime?

  status       FollowUpStatus @default(PENDING)
  errorMessage String?        @db.Text

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  smtpConfig   SMTPConfig    @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)
  thread       InboxThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  message      InboxMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId, status])
  @@index([smtpConfigId])
}

// ==================================================
// INBOX SYNC STATE
// ==================================================

model InboxSyncState {
  id           String      @id @default(cuid())
  smtpConfigId String      @unique

  lastSyncAt   DateTime?
  historyId    String?
  uidValidity  String?
  lastUid      String?
  cursor       String?
  errorMessage String?     @db.Text

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  smtpConfig   SMTPConfig  @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)
}

// ==================================================
// FOLLOW-UP CAMPAIGN
// ==================================================

model FollowUpCampaign {
  id              String                 @id @default(cuid())
  userId          String
  campaignType    String?
  name            String

  status          FollowUpCampaignStatus @default(DRAFT)

  stopOnReply     Boolean                @default(true)
  greetingEnabled Boolean?               @default(true)
  spinTextEnabled Boolean?               @default(true)
  scheduledAt     DateTime?

  timezone        String                 @default("Asia/Karachi")
  sendingStart    String                 @default("09:00")
  sendingEnd      String                 @default("18:00")

  intervalValue   Int?                   @default(1)
  intervalUnit    String?                @default("minutes")
  dailyLimit      Int?                   @default(50)

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  smtpConfigs     SMTPConfig[]

  steps           FollowUpStep[]
  recipients      FollowUpRecipient[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

enum FollowUpIntervalUnit {
  seconds
  minutes
  hours
  days
}
// ==================================================
// FOLLOW-UP STEP
// ==================================================

model FollowUpStep {
  id          String   @id @default(cuid())
  campaignId  String

  stepNumber  Int
  delayDays   Int

  subject     String
  body        String   @db.LongText

  enabled     Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign       FollowUpCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientSteps FollowUpRecipientStep[]
  templates EmailTemplate[]

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

// ==================================================
// FOLLOW-UP RECIPIENT
// ==================================================

model FollowUpRecipient {
  id           String                  @id @default(cuid())
  campaignId   String
  emailId      String

  status       FollowUpRecipientStatus @default(PENDING)

  currentStep  Int                     @default(0)

  nextStepAt   DateTime?
  lastSentAt   DateTime?
  repliedAt    DateTime?
  completedAt  DateTime?

  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  campaign     FollowUpCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        Email                   @relation(fields: [emailId], references: [id], onDelete: Cascade)

  steps        FollowUpRecipientStep[]

  @@unique([campaignId, emailId])
  @@index([campaignId])
  @@index([emailId])
  @@index([status])
  @@index([nextStepAt])
}

// ==================================================
// FOLLOW-UP RECIPIENT STEP
// ==================================================

model FollowUpRecipientStep {
  id           String            @id @default(cuid())
  recipientId  String
  stepId       String

  status       FollowUpStepStatus @default(PENDING)

  scheduledAt  DateTime?
  sentAt       DateTime?
  failedAt     DateTime?

  error        String?           @db.Text

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  recipient    FollowUpRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  step         FollowUpStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([recipientId, stepId])
  @@index([status])
  @@index([scheduledAt])
}

// ==================================================
// ENUMS
// ==================================================

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EmailStatus {
  PENDING
  VALID
  INVALID
  SENT
  FAILED
  BOUNCED
  REPLIED
  UNSUBSCRIBED
}

enum FollowUpCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
}

enum FollowUpRecipientStatus {
  PENDING
  RUNNING
  REPLIED
  COMPLETED
  FAILED
  STOPPED
}

enum FollowUpStepStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum FollowUpStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum EmailProvider {
  SMTP
  GMAIL
  OUTLOOK
}
