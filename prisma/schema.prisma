generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  phone             String         @unique
  passwordHash      String
  name              String?
  role              UserRole       @default(USER)
  status            UserStatus     @default(DISABLED)
  passwordExpiresAt DateTime
  sessionExpiresAt  DateTime?
    
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  smtpConfigs       SMTPConfig[]
    emails            Email[]
  systemConfig      SystemConfig[]
  emailTemplates EmailTemplate[]
  inboxThreads   InboxThread[]
  inboxFollowUps InboxFollowUp[]
}

model SMTPConfig {
  id          String   @id @default(cuid())
  userId      String
  host        String?
  port        Int?
  spixwork Json?
  username    String?
  password    String?
  senderEmail String
  senderName  String?
provider     EmailProvider @default(SMTP)
accessToken  String? @db.Text
refreshToken String? @db.Text
tokenExpiry  DateTime?
imapHost   String?
imapPort   Int?
imapSecure Boolean @default(true)
  isActive    Boolean  @default(false)
  warmup      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailHealth EmailHealth?
  inboxThreads   InboxThread[]
  inboxMessages  InboxMessage[]
  inboxFollowUps InboxFollowUp[]
  inboxSyncState InboxSyncState?
  @@unique([userId, senderEmail])
}

model SystemConfig {
  id          String   @id @default(cuid())
  userId      String
  host        String?
  port        Int?
  username    String?
  password    String?
  senderEmail String
  senderName  String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([userId, senderEmail])
}


enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}


model EmailTemplate {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject   String
  body String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


model Email {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  
  name        String?

  email       String

  company     String?
  website     String?
  phone       String?

  category    String?

  status      EmailStatus @default(PENDING)

  isVerified  Boolean @default(false)
  isValid     Boolean?

  notes       String? @db.Text

  customFields Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  
  @@index([userId])
  
  @@index([email])
  @@index([category])
}



model EmailHealth {
  id               String   @id @default(cuid())

  smtpConfigId     String   @unique
  smtpConfig       SMTPConfig @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)

  warmupDay        Int      @default(1)
  dailyLimit       Int      @default(3)

  totalSent        Int      @default(0)
  totalReplies     Int      @default(0)

  todaySent        Int      @default(0)
  nextWarmupAt DateTime?
  todayReplies     Int      @default(0)

  health           Int      @default(0)

  startedAt        DateTime @default(now())
  lastWarmupDate   DateTime?
  completed        Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum EmailStatus {
  PENDING
  VALID
  INVALID
  SENT
  FAILED
  BOUNCED
  REPLIED
  UNSUBSCRIBED
}

model SpinGreeting {
  id        String   @id @default(cuid())
  userId    String
  value     String
  createdAt DateTime @default(now())
  spixwork  Boolean? @default(false)
  @@unique([userId, value])
  @@index([userId])
}

// ==================================================
// INBOX MODULE
// ==================================================

model InboxThread {
  id               String    @id @default(cuid())
  userId           String
  smtpConfigId     String
  providerThreadId String?   // Gmail threadId or IMAP conversation key
  subject          String?   @db.Text
  participants     Json?     // string[] of emails
  lastMessageAt    DateTime?
  unreadCount      Int       @default(0)
  isStarred        Boolean   @default(false)
  isArchived       Boolean   @default(false)
  isDeleted        Boolean   @default(false)
  snippet          String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  smtpConfig SMTPConfig      @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)
  messages   InboxMessage[]
  followUps  InboxFollowUp[]

  @@unique([smtpConfigId, providerThreadId])
  @@index([userId, smtpConfigId])
  @@index([userId, lastMessageAt])
  @@index([smtpConfigId, isArchived, isDeleted])
}

model InboxMessage {
  id                String           @id @default(cuid())
  threadId          String
  smtpConfigId      String
  providerMessageId String           // Gmail msg id or IMAP UID / Message-ID
  inReplyTo         String?
  references        String?          @db.Text
  fromEmail         String
  fromName          String?
  toEmails          Json             // string[]
  ccEmails          Json?
  bccEmails         Json?
  subject           String?          @db.Text
  textBody          String?          @db.LongText
  htmlBody          String?          @db.LongText
  snippet           String?          @db.Text
  receivedAt        DateTime?
  sentAt            DateTime?
  isRead            Boolean          @default(false)
  isStarred         Boolean          @default(false)
  direction         MessageDirection @default(INCOMING)
  hasAttachments    Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  thread      InboxThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  smtpConfig  SMTPConfig        @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)
  attachments InboxAttachment[]
  followUps   InboxFollowUp[]

  @@unique([smtpConfigId, providerMessageId])
  @@index([threadId, receivedAt])
  @@index([smtpConfigId, isRead])
}

model InboxAttachment {
  id                   String   @id @default(cuid())
  messageId            String
  filename             String
  contentType          String?
  size                 Int?
  storagePath          String?
  contentId            String?
  providerAttachmentId String?
  createdAt            DateTime @default(now())

  message InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model InboxFollowUp {
  id           String         @id @default(cuid())
  userId       String
  smtpConfigId String
  threadId     String?
  messageId    String?
  toEmail      String
  ccEmails     Json?
  subject      String
  body         String         @db.LongText
  scheduledAt  DateTime
  sentAt       DateTime?
  status       FollowUpStatus @default(PENDING)
  errorMessage String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  smtpConfig SMTPConfig    @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)
  thread     InboxThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  message    InboxMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId, status])
  @@index([smtpConfigId])
}

model InboxSyncState {
  id           String    @id @default(cuid())
  smtpConfigId String    @unique
  lastSyncAt   DateTime?
  historyId    String?   // Gmail
  uidValidity  String?   // IMAP
  lastUid      String?   // IMAP
  cursor       String?
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  smtpConfig SMTPConfig @relation(fields: [smtpConfigId], references: [id], onDelete: Cascade)
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum FollowUpStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}


enum EmailProvider {
  SMTP
  GMAIL
  OUTLOOK
}